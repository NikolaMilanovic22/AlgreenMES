#!/usr/bin/env bash
# Pre-commit checks that catch the two BE regressions we've shipped in the
# last week — the tenant-filter no-op (19.06.2026 security fix) and the
# magic IsInRole("SuperAdmin") strings that drift from the typed helper.
# Run on every commit; total budget under 1s since these are plain greps.
#
# Install once after cloning:
#   git config core.hooksPath .githooks

set -e

# ─── Check 1: EF.Property<Guid>("TenantId") trap ───────────────────
# Background: TenantEntity.TenantId became Guid? on 16.06.2026 when
# SuperAdmins went tenantless. The pre-existing HasQueryFilter lambda
# kept using EF.Property<Guid> on the now-nullable column and silently
# stopped matching — every TenantEntity child became cross-tenant
# readable for 3 days before integration tests caught it. The fix is
# always EF.Property<Guid?> here; this check stops a revert.
EF_HITS=$(grep -rn --include='*.cs' --exclude-dir=bin --exclude-dir=obj'EF\.Property<Guid>([^)]*"TenantId"' src/ AlgreenMES.API/ 2>/dev/null \
  || true)

if [ -n "$EF_HITS" ]; then
  echo "✗ EF.Property<Guid>(... \"TenantId\" ...) found — use EF.Property<Guid?> instead."
  echo "  TenantEntity.TenantId is nullable; the typed lambda silently no-ops"
  echo "  on a nullable column and turns the tenant filter off."
  echo
  echo "$EF_HITS"
  exit 1
fi

# ─── Check 2: Magic IsInRole("…") strings outside RoleNames.cs ────
# We have RoleNames + ICurrentUserService.IsSuperAdmin specifically so
# a typo in the string form can't silently flip auth to false. Catch
# any caller that's still using the literal-string form.
ROLE_HITS=$(grep -rn --include='*.cs' --exclude-dir=bin --exclude-dir=obj'IsInRole("' src/ AlgreenMES.API/ 2>/dev/null \
  | grep -v 'RoleNames\.cs' \
  | grep -v '// ' \
  || true)

if [ -n "$ROLE_HITS" ]; then
  echo "✗ Magic IsInRole(\"…\") string found — use RoleNames.* or _currentUser.IsSuperAdmin."
  echo "  A typo in the string form silently flips authorization to false:"
  echo "  the SA case never fires and the handler treats them as a regular user."
  echo
  echo "$ROLE_HITS"
  exit 1
fi

# ─── Check 3: Magic [Authorize(Roles = "…")] strings ───────────────
# RoleGroups.AdminUp / ManagerUp / etc. replaced 76 magic-string
# attributes on 19.06.2026. Catch any new attribute that drifts back.
AUTHZ_HITS=$(grep -rn --include='*.cs' --exclude-dir=bin --exclude-dir=obj'\[Authorize(Roles\s*=\s*"' src/ AlgreenMES.API/ 2>/dev/null \
  | grep -vE ':\s*(//|\*|///)' \
  || true)

if [ -n "$AUTHZ_HITS" ]; then
  echo "✗ [Authorize(Roles = \"…\")] literal string found — use RoleGroups.* constant."
  echo "  RoleGroups names per seniority: SuperAdminOnly, AdminUp, ManagerUp,"
  echo "  CoordinatorUp, ManagerOrSales, ManagerOrWarehouse, ProductionFloor,"
  echo "  AnyAuthenticated."
  echo
  echo "$AUTHZ_HITS"
  exit 1
fi

echo "✓ BE static checks: 0 issues"
